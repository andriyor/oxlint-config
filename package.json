{
  "name": "@andriyor/oxlint-config",
  "version": "0.2.0",
  "description": "Shared oxlint config for React + TypeScript + Vitest projects",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andriyor/oxlint-config.git"
  },
  "exports": {
    ".": {
      "types": "./config.d.ts",
      "default": "./oxlint.config.js"
    },
    "./base": {
      "types": "./config.d.ts",
      "default": "./configs/base.js"
    },
    "./react": {
      "types": "./config.d.ts",
      "default": "./configs/react.js"
    },
    "./vitest": {
      "types": "./config.d.ts",
      "default": "./configs/vitest.js"
    }
  },
  "files": [
    "oxlint.config.js",
    "configs",
    "preset.js",
    "config.d.ts"
  ],
  "scripts": {
    "test": "node test/smoke.js"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.8.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "oxlint-config-presets": "^0.1.19"
  },
  "peerDependencies": {
    "oxlint": "^1.81.0"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  },
  "packageManager": "pnpm@12.3.1"
}
